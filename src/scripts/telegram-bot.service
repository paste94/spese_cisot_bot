# /home/pi/.config/systemd/user/telegram-bot.service
[Unit]
Description=Telegram Bot
After=network.target

[Service]
WorkingDirectory=/home/pi/Applications/spese_cisot_bot
ExecStart=/home/pi/Applications/spese_cisot_bot/src/scripts/run.sh
Restart=always
RestartSec=5
#StandardOutput=append:/home/pi/Applications/spese_cisot_bot/log/bot.log
#StandardError=append:/home/pi/Applications/spese_cisot_bot/log/error_bot.log

[Install]
WantedBy=default.target